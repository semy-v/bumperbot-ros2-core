<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="bumperbot">

    <ros2_control name="RobotSystem" type="system">
        <!-- ros2_control Jazzy Gazebo -->
        <xacro:if value="$(arg is_sim)">
            <hardware>
                <plugin>gz_ros2_control/GazeboSimSystem</plugin>
            </hardware>
        </xacro:if>

        <!-- ros2_control Real Robot -->
        <xacro:unless value="$(arg is_sim)">
            <hardware>
                <plugin>bumperbot_firmware/RobotSystemInterface</plugin>
                <param name="port">/dev/ttyACM0</param>
                <param name="wheels_control_rate_hz">100</param>
                <param name="wheels_min_velocity">2.0</param>
                <param name="wheel_right_feedforward_ks_forward">17.34</param>
                <param name="wheel_right_feedforward_ks_reverse">15.26</param>
                <param name="wheel_right_feedforward_kv">14.72</param>
                <param name="wheel_right_feedback_kp">3.0</param>
                <param name="wheel_right_feedback_ki">27.0</param>
                <param name="wheel_right_feedback_kd">0.0</param>
                <param name="wheel_right_max_feedback_pwm">50</param>
                <param name="wheel_left_feedforward_ks_forward">17.86</param>
                <param name="wheel_left_feedforward_ks_reverse">15.68</param>
                <param name="wheel_left_feedforward_kv">14.26</param>
                <param name="wheel_left_feedback_kp">3.0</param>
                <param name="wheel_left_feedback_ki">25.0</param>
                <param name="wheel_left_feedback_kd">0.0</param>
                <param name="wheel_left_max_feedback_pwm">50</param>
            </hardware>
            <sensor name="imu_sensor">
                <state_interface name="orientation.x"/>
                <state_interface name="orientation.y"/>
                <state_interface name="orientation.z"/>
                <state_interface name="orientation.w"/>
                <state_interface name="angular_velocity.x"/>
                <state_interface name="angular_velocity.y"/>
                <state_interface name="angular_velocity.z"/>
                <state_interface name="linear_acceleration.x"/>
                <state_interface name="linear_acceleration.y"/>
                <state_interface name="linear_acceleration.z"/>
            </sensor>
        </xacro:unless>

        <!-- ros2_control Common Interfaces -->
        <joint name="wheel_left_joint">
            <command_interface name="velocity">
              <param name="min">-1</param>
              <param name="max">1</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="wheel_right_joint">
            <command_interface name="velocity">
              <param name="min">-1</param>
              <param name="max">1</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>
    </ros2_control>

</robot>